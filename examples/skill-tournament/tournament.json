        {"a": "v_terse",  "b": "v_strict", "judge": "injection-check",  "winner": "b", "rationale": "v_strict has prompt-injection guard"},
        {"a": "v_terse",  "b": "v_chain",  "judge": "injection-check",  "winner": "b", "rationale": "v_chain inherits v_strict's guard"},
        {"a": "v_strict", "b": "v_chain",  "judge": "injection-check",  "winner": "draw", "rationale": "same guard"}
      ]
    },
    {
      "name": "behavioural",
      "k": 24,
      "matches": [
        {"a": "v_terse",  "b": "v_strict", "judge": "completion-quality", "winner": "b", "rationale": "v_strict's outputs answer the prompt; v_terse cuts off"},
        {"a": "v_terse",  "b": "v_chain",  "judge": "completion-quality", "winner": "b", "rationale": "v_chain reasons before writing"},
        {"a": "v_strict", "b": "v_chain",  "judge": "completion-quality", "winner": "b", "rationale": "v_chain's CoT step yields better summaries"},
        {"a": "v_terse",  "b": "v_strict", "judge": "latency-fit",         "winner": "a", "rationale": "v_terse is fastest"},
        {"a": "v_terse",  "b": "v_chain",  "judge": "latency-fit",         "winner": "a", "rationale": "v_chain's CoT slows it"},
        {"a": "v_strict", "b": "v_chain",  "judge": "latency-fit",         "winner": "a", "rationale": "v_strict avoids CoT overhead"}
