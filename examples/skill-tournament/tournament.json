        {"a": "v_terse",  "b": "v_strict", "judge": "cross-vendor-eval", "winner": "b", "rationale": "v_strict more portable across model families"},
        {"a": "v_terse",  "b": "v_chain",  "judge": "cross-vendor-eval", "winner": "b", "rationale": "v_chain CoT survives cross-model"},
        {"a": "v_strict", "b": "v_chain",  "judge": "cross-vendor-eval", "winner": "b", "rationale": "CoT helps weaker model families more"}
      ]
    }
  ]
